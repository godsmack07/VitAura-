generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// enum Corporation {
//   Electrical
//   Sanitation
//   Civil
//   Disaster
//   Maintanence
// }

model User {
  id       Int    @id @default(autoincrement())
  Username String
  Email    String
}

model Issue {
  id          Int    @id @default(autoincrement())
  image       String
  issue       String
  location    String
  description String
  mobileNo    String

  severity    String
  priority    String
  corporation String
  resolved    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime
  // deletedAt DateTime
}
